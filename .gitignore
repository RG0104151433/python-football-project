# Virtual environment (never distribute; it binds to one machine's absolute paths)
.venv/

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
outputs/test_tmp/

# Recomputable full-world resume cache; published experiment tables remain tracked.
outputs/logs/strength_inference/checkpoints/

# Q6 resumable per-job cache; final predictions, models, boundaries and source
# snapshots outside jobs/ remain versioned and sufficient for independent audit.
outputs/logs/history_window/outcome-*/jobs/
outputs/logs/history_window/rating-memory-*/jobs/
outputs/logs/history_window/joint-*/jobs/
outputs/logs/history_window/reliability-*/probe_jobs/

# IDE
.idea/
.vscode/
.ipynb_checkpoints/

# WorkBuddy local tooling
.workbuddy/

# OS junk
Thumbs.db
.DS_Store

# NOTE: data/raw/ (frozen snapshot), data/processed/, data/external/ and
# outputs/figures|tables|logs are deliberately NOT ignored:
# the snapshot and results must be committed so the project runs offline.

# LaTeX local compilation products; keep TeX/Bib sources versioned.
/paper/build/

# Local course-delivery archives and extracted verification copies.
# Keep inventories, instructions and check records versioned for reconstruction.
/交付材料/*.zip
/交付材料/Report.pdf
/交付材料/**/*.zip
/交付材料/**/*.pdf
/交付材料/03_课堂展示/index.html
/交付材料/03_课堂展示/repository_architecture.html
/交付材料/_验收解压/

# Browser screenshots, temporary upstream checkout and presentation QA cache.
/presentation/_build/

# Local sharing bundles: keep source folders and frozen versions in Git instead.
/交付材料.zip
/presentation/versions/*.zip
