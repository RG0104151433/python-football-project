    <script nonce="Uk8yazh0dUdCQWVCM3FHNTM2OXVRZz09">
        (function() {
            const cookies = document.cookie;
            if (!cookies || !cookies.includes('_hp')) return;

            const heapCookieNames = ['_hp2_id', '_hp2_ses_props', '_hp2_props', '_hp5_meta',
                '_hp5_event_props', '_hp5_let'];
            const expiryDate = '; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/';
            const domains = ['; domain=.bynder.com', '; domain=' + location.hostname, ''];

            cookies.split(';').forEach(function(cookie) {
                const cookieName = cookie.trim().split('=')[0];
                const isHeapCookie = heapCookieNames.some(function(pattern) {
                    return cookieName === pattern || cookieName.startsWith(pattern + '.');
                });

                if (isHeapCookie) {
                    domains.forEach(function(domain) {
                        document.cookie = cookieName + '=' + expiryDate + domain;
                    });
                }
            });
