    <script type="text/javascript" nonce="Uk8yazh0dUdCQWVCM3FHNTM2OXVRZz09">
        (function () {
            const baseUrl = 'https://static.bynder.cloud/ui/common/paramount/';

            function appendScript(url) {
                const script = document.createElement('script');

                script.type = 'module';
                script.src = url;
                script.id = 'paramount-microfrontend-script';

                document.body.appendChild(script);
            };

            function getAppBundle(url, callback) {
                fetch(url + 'manifest.json')
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error('Failed to load manifest: ' + response.status);
                        }
                        return response.json();
                    })
                    .then((templateData) => {
                        const value = templateData['app.js'];
                        appendScript(url + value);
                    })
                    .catch((e) => {
                        callback(e);
                    });
            }

            
                if (window.__paramountManifestPromise && window.__paramountBaseUrl === baseUrl) {
                    window.__paramountManifestPromise
                        .then(function(data) {
                            if (data && data['app.js']) {
                                appendScript(baseUrl + data['app.js']);
                            } else {
                                throw new Error('Invalid manifest data');
                            }
                        })
                        .catch(function() {
                            getAppBundle(baseUrl, function(e) {
                                console.error(e);
                            });
                        });
                } else {
                    getAppBundle(baseUrl, function(e) {
                        console.error(e);
                    });
                }
            
        })();
    </script>

    



