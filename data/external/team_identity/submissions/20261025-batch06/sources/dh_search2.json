    <script nonce="Uk8yazh0dUdCQWVCM3FHNTM2OXVRZz09">
        (() => {
            const baseUrl = 'https://static.bynder.cloud/ui/common/paramount/';

            window.__paramountBaseUrl = baseUrl;
            window.__paramountManifestPromise = fetch(baseUrl + 'manifest.json')
                .then(r => r.json());

            window.__paramountManifestPromise
                .then(data => {
                    if (data['app.js']) {
                        const link = document.createElement('link');
                        link.rel = 'modulepreload';
                        link.href = baseUrl + data['app.js'];
                        document.head.appendChild(link);
                    }
                })
                .catch(() => {}); // failures are intentionally ignored here because microfrontends.cfm has its own .catch() with the jQuery fallback
        })();
    </script>

