<script nonce="YdKp6lP9+TwWMEcfHCkv6w==">
    (async function () {
        const paramountCdnUrl = 'https://static.bynder.cloud/ui/common/paramount/';

        async function fetchManifest(url) {
            const response = await fetch(url + 'manifest.json');

            if (!response.ok) {
                throw new Error('Failed to fetch manifest: ' + response.status);
            }

            const manifest = await response.json();

            if (!manifest['app.js']) {
                throw new Error('Manifest is missing the "app.js" entry');
            }

            return manifest;
        }

        async function loadAppBundle(url) {
            const preloaded = url === paramountCdnUrl && window.__paramountManifestPromise;

            let manifest;
            if (preloaded) {
                try {
                    manifest = await window.__paramountManifestPromise;
                } catch (e) {
                    manifest = await fetchManifest(url);
                }
            } else {
                manifest = await fetchManifest(url);
            }

            const script = document.createElement('script');
            script.type = 'module';
            script.src = url + manifest['app.js'];
            script.id = 'paramount-microfrontend-script';
            document.body.appendChild(script);
        }


        try {
            await loadAppBundle(paramountCdnUrl);
        } catch (e) {
            console.error(e);
        }
    })();
</script>



<div id="conversational-ai"></div>
<script nonce="YdKp6lP9+TwWMEcfHCkv6w==">
    (function(){

        const addChunkScript = (src) => {
            const script = document.createElement('script');
            script.type = 'module';
            script.src = src;
            document.body.appendChild(script);
        }

        const addChunkCss = (href) => {
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = href;
            document.head.appendChild(link);
        }

        function loadFromManifest(url) {
            fetch(url + 'manifest.json')
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    const chunk = data['src/main.jsx'];
                    if (chunk.file) {
                        addChunkScript(url + chunk.file)
                    }

                    if(Array.isArray(chunk.css)){
                        chunk.css.forEach(cssFile => addChunkCss(url + cssFile))
                    }
                })
                .catch(function(e) {
                    console.error('Failed to load manifest:', e);
                });
        }

        loadFromManifest('https://static.bynder.cloud/ui/conversational-ai/conversational-ai/');
    })()
</script>


    


