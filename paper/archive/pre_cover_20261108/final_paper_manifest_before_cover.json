    {
      "file": "sections/introduction.tex",
      "before": "Match context comprises the era, match type, and geographic groups of both teams.",
      "after": "Match context comprises the era, match type, and geographic groups of both teams. The terms context and background refer to this same set of variables throughout the paper.",
