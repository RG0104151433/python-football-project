# Keep source/config text consistent across Windows and other systems.
.gitattributes text eol=lf
*.py text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
requirements.* text eol=lf
# Preserve registered input/artifact bytes; override extension defaults above.
data/raw/** -text
data/processed/** -text
data/external/** -text
outputs/** -text
参考资料/方法文献/原文/** -text
# Source snapshots and generated run evidence are not application source code.
data/external/** linguist-vendored
outputs/logs/** linguist-generated
参考资料/方法文献/原文/** linguist-documentation
# Generated scientific presentation, rebuilt from the versioned Python results.
研究/05_赛前实力/展示/** -text linguist-generated
